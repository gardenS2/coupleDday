# Development settings for .env.dev.
# Blank values allow design preview. For local Supabase, use http://127.0.0.1:55431.
# Android emulator URL is converted automatically by npm run android:dev.
EXPO_PUBLIC_SUPABASE_URL=
# #여기에 운영key추가 — 개발 환경에는 개발 프로젝트의 공개 키만 입력
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
